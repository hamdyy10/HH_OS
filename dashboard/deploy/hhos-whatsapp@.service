# /etc/systemd/system/hhos-whatsapp@.service
#
# One instance per WhatsApp channel: `systemctl start hhos-whatsapp@support`.
# Everything instance-specific is in /opt/hhos-agents/channels/%i, written by
# the dashboard through hhos-helper.

[Unit]
Description=HH WhatsApp channel %i
Documentation=https://github.com/hamdyy10/HH_OS
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hhosagent
Group=hhosagent
WorkingDirectory=/opt/hhos-agents/whatsapp

Environment=HOME=/opt/hhos-agents/shared/home
Environment=PATH=/opt/hhos-agents/runtime/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
# Server Claude Code, not the SDK-bundled 2.1.139 (rejects newer models).
Environment=CLAUDE_CLI_PATH=/usr/bin/claude

# The Claude credential, shared with every agent.
EnvironmentFile=-/opt/hhos-agents/shared/claude-auth.env
# Channel identity, allowed numbers and add-on switches.
EnvironmentFile=/opt/hhos-agents/channels/%i/bridge.env

ExecStart=/usr/bin/node /opt/hhos-agents/whatsapp/bridge.mjs

Restart=always
RestartSec=10
MemoryMax=4G
TasksMax=512

# Same posture as the agent unit: this process runs model-authored commands.
# It needs write access to the channel directory (session credentials) and to
# the agent's vault (attachments and memory), and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hhos-agents/channels/%i /opt/hhos-agents/agents /opt/hhos-agents/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hhos-whatsapp-%i

[Install]
WantedBy=multi-user.target
