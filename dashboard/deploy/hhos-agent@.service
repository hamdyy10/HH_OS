# /etc/systemd/system/hhos-agent@.service
#
# One instance per agent: `systemctl start hhos-agent@sales-bot`.
# Everything instance-specific lives in /opt/hhos-agents/agents/%i, written by
# the dashboard through hhos-helper. Never edit an instance by hand -- the next
# configuration change from the panel regenerates it.

[Unit]
Description=HH agent %i (Telegram bridge to Claude Code)
Documentation=https://github.com/hamdyy10/HH_OS
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hhosagent
Group=hhosagent
WorkingDirectory=/opt/hhos-agents/agents/%i

Environment=HOME=/opt/hhos-agents/shared/home
Environment=PATH=/opt/hhos-agents/runtime/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HHOS_MODEL_CACHE=/opt/hhos-agents/shared/models
Environment=PYTHONUNBUFFERED=1
# Use the server's Claude Code, not the copy bundled with the Python SDK:
# the bundled one (2.1.139) rejects newer models such as claude-opus-5-5
# ("version 2.1.280 or newer is required", HH Pace 2026-10-25).
Environment=CLAUDE_CLI_PATH=/usr/bin/claude

# Claude authentication, shared by every agent (0640 root:hhosagent).
# Leading '-' so an agent still starts to report a clear error if it is missing.
EnvironmentFile=-/opt/hhos-agents/shared/claude-auth.env
EnvironmentFile=/opt/hhos-agents/agents/%i/agent.env

ExecStart=/opt/hhos-agents/runtime/venv/bin/claude-telegram-bot

Restart=always
RestartSec=10
MemoryMax=8G
TasksMax=512

# This process runs commands a language model chose. Give it as little of the
# host as it can still do its job with. An attached project directory is added
# back by a per-agent drop-in, not by widening these.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hhos-agents/agents/%i /opt/hhos-agents/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hhos-agent-%i

[Install]
WantedBy=multi-user.target
