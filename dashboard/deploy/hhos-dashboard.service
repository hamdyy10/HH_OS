[Unit]
Description=HH VPS admin dashboard
Documentation=file:/home/ubuntu/workspace/SETUP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hhosadmin
Group=hhosadmin
WorkingDirectory=/opt/hhos-dashboard
ExecStart=/usr/bin/node /opt/hhos-dashboard/server.js
Restart=on-failure
RestartSec=3

Environment=NODE_ENV=production
Environment=HHOS_BIND=127.0.0.1
Environment=HHOS_PORT=3000
Environment=HHOS_DATA_DIR=/var/lib/hhos-dashboard
Environment=HHOS_LOG_DIR=/var/log/hhos-dashboard
Environment=HHOS_PUBLIC_HOST=old-server.hh-os.example
Environment=HHOS_PUBLIC_PORT=8443
# The app icon (lib/ui.js appIconSet): "bot" = HH AI's head with the cap (public/brand/bot/, since
# desktop 0.1.9, 2026-10-20); unset or anything else = the Mesh icon.
Environment=HH_APP_ICON=bot

# --- sandboxing -------------------------------------------------------------
# NOTE: NoNewPrivileges MUST stay false. The dashboard escalates through
# `sudo hhos-helper` for the few operations that need root; setting
# NoNewPrivileges=yes would silently break every privileged action.
NoNewPrivileges=false

PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=no
LockPersonality=yes

ReadWritePaths=/var/lib/hhos-dashboard /var/log/hhos-dashboard

# ProtectSystem=full makes /etc read-only, and sudo's child inherits this
# unit's mount namespace -- so without this, hhos-helper cannot write the
# per-agent systemd drop-ins even though it runs as root.
#
# This grants the namespace, not the service account: /etc/systemd/system is
# 0755 root:root, so hhosadmin still cannot write a unit file. Only hhos-helper,
# which is root, can.
ReadWritePaths=/etc/systemd/system

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hhos-dashboard

[Install]
WantedBy=multi-user.target
